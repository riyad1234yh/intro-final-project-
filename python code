

def add_event(event_names, event_fees, event_seats):
    """Collects and validates event details, then appends to the aligned lists."""
    print("\n--- Add a New Event ---")
    name = input("Enter unique event name: ").strip()
    
    # Validate blank names
    if not name:
        print("Error: Event name cannot be blank.")
        return
    
    # Validate duplicate names (case-insensitive check)
    if name.lower() in [e.lower() for e in event_names]:
        print(f"Error: An event named '{name}' already exists.")
        return
    
    # Validate fee input
    try:
        fee = float(input("Enter registration fee ($): "))
        if fee < 0:
            print("Error: Registration fee cannot be negative.")
            return
    except ValueError:
        print("Error: Invalid numeric format for fee.")
        return
        
    # Validate available seats input
    try:
        seats = int(input("Enter number of available seats: "))
        if seats <= 0:
            print("Error: Available seats must be a positive integer greater than zero.")
            return
    except ValueError:
        print("Error: Invalid integer format for seats.")
        return
        
    # Append to aligned lists
    event_names.append(name)
    event_fees.append(fee)
    event_seats.append(seats)
    print(f"Success: Event '{name}' added successfully!")


def view_events(event_names, event_fees, event_seats):
    """Iterates through the aligned lists and displays a numbered, readable event summary."""
    print("\n--- Current Campus Events ---")
    if len(event_names) == 0:
        print("No events have been added yet.")
        return
    
    print(f"{'No.':<5} | {'Event Name':<25} | {'Fee ($)':<10} | {'Available Seats':<15}")
    print("-" * 63)
    for i in range(len(event_names)):
        print(f"{i + 1:<5} | {event_names[i]:<25} | {event_fees[i]:<10.2f} | {event_seats[i]:<15}")


def register_seats(event_names, event_fees, event_seats):
    """Locates an event, validates quantity, updates seat count, and calculates total fee."""
    print("\n--- Register Seats for an Event ---")
    if len(event_names) == 0:
        print("No events available for registration. Please add an event first.")
        return
    
    # Display events first to help the user
    view_events(event_names, event_fees, event_seats)
    
    target_name = input("\nEnter the exact name of the event you wish to register for: ").strip()
    
    # Find event index
    found_index = -1
    for i in range(len(event_names)):
        if event_names[i].lower() == target_name.lower():
            found_index = i
            break
            
    if found_index == -1:
        print(f"Error: Event '{target_name}' not found.")
        return
        
    # Validate requested quantity
    try:
        quantity = int(input(f"Enter number of seats requested for '{event_names[found_index]}': "))
        if quantity <= 0:
            print("Error: You must request at least 1 seat.")
            return
    except ValueError:
        print("Error: Invalid integer format for seat quantity.")
        return
        
    # Check seat availability
    available = event_seats[found_index]
    if quantity > available:
        print(f"Error: Not enough seats available. Only {available} seat(s) remaining for this event.")
        return
        
    # Update availability
    event_seats[found_index] -= quantity
    
    # Calculate fee
    unit_fee = event_fees[found_index]
    total_fee = unit_fee * quantity
    
    # Display confirmation receipt
    print("\n" + "=" * 40)
    print("      REGISTRATION CONFIRMATION      ")
    print("=" * 40)
    print(f"Event Name   : {event_names[found_index]}")
    print(f"Quantity     : {quantity}")
    print(f"Unit Fee     : ${unit_fee:.2f}")
    print(f"Total Fee    : ${total_fee:.2f}")
    print(f"Seats Left   : {event_seats[found_index]}")
    print("=" * 40)
    print("Registration completed successfully!")


def main():
    """Main function using a while loop to run the menu-driven application."""
    # Required aligned data structures
    event_names = []
    event_fees = []
    event_seats = []
    
    print("Welcome to the Campus Event Registration System!")
    
    while True:
        print("\n================ MENU ================")
        print("1. Add an Event")
        print("2. View Events")
        print("3. Register Seats")
        print("4. Exit")
        print("======================================")
        
        choice_input = input("Enter your choice (1-4): ").strip()
        
        # Controlled input for menu option
        try:
            choice = int(choice_input)
        except ValueError:
            print("Error: Please enter a valid integer between 1 and 4.")
            continue
            
        if choice == 1:
            add_event(event_names, event_fees, event_seats)
        elif choice == 2:
            view_events(event_names, event_fees, event_seats)
        elif choice == 3:
            register_seats(event_names, event_fees, event_seats)
        elif choice == 4:
            print("\nThank you for using the Campus Event Registration System. Goodbye!")
            break
        else:
            print("Error: Invalid choice. Please select an option from 1 to 4.")


if __name__ == "__main__":
    main()